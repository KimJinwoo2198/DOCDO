APP_NAME=DOCDO API
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./.data/docdo.db
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
DOCUMENT_ENCRYPTION_KEY=replace-with-a-different-32-character-secret
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

ANALYSIS_INLINE=true
MAX_UPLOAD_BYTES=15728640
MAX_DOCUMENT_BYTES=31457280
MAX_DOCUMENT_PAGES=10
MIN_FIELD_CONFIDENCE=0.85

STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=.storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=docdo-admin
S3_SECRET_KEY=replace-this-minio-password
S3_BUCKET=docdo-assets
S3_REGION=ap-northeast-2
ASSET_RETENTION_DAYS=7

# mock은 CI와 명시적인 데모 실행에서만 사용합니다.
PROVIDER_MODE=studio
UPSTAGE_API_KEY=
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
UPSTAGE_DOCUMENT_MODEL=document-parse
UPSTAGE_SOLAR_MODEL=solar-pro4
UPSTAGE_STUDIO_BASE_URL=https://api.upstage.ai/v2
UPSTAGE_STUDIO_AGENT_ID=
UPSTAGE_STUDIO_CONFIG_ID=
UPSTAGE_STUDIO_TIMEOUT_SECONDS=240
UPSTAGE_STUDIO_POLL_SECONDS=1

INVITATION_TTL_MINUTES=15
INVITATION_ATTEMPT_LIMIT=10
