{
  "name": "docdo-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0 || >=25.0.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:build": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest --runInBand",
    "api:generate": "openapi-ts -i ${OPENAPI_URL:-http://localhost:8000/openapi.json} -o src/api/generated"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans-kr": "^0.4.3",
    "@expo/vector-icons": "^15.0.2",
    "@tanstack/react-query": "5.101.4",
    "expo": "57.0.15",
    "expo-camera": "~57.0.4",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "57.0.13",
    "expo-document-picker": "57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-image-manipulator": "~57.0.12",
    "expo-image-picker": "57.0.12",
    "expo-linking": "57.0.7",
    "expo-notifications": "~57.0.13",
    "expo-router": "57.0.15",
    "expo-secure-store": "57.0.1",
    "expo-speech": "~57.0.1",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "babel-preset-expo": "57.0.7",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "jest-expo": "~57.0.4",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleDirectories": [
      "node_modules",
      "node_modules/expo/node_modules"
    ]
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "uuid": "11.1.1"
  }
