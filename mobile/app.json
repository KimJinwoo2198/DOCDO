{
  "expo": {
    "name": "DOCDO",
    "slug": "docdo",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "docdo",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.junctionasia.docdo",
      "appleTeamId": "3K9TNZ5F2A",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Mac에서 실행 중인 DOCDO 개발 서버와 연결하기 위해 로컬 네트워크 접근이 필요합니다."
      }
    },
    "android": {
      "package": "com.junctionasia.docdo",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#5E5CE6"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "문서를 분석하기 위해 사진 접근이 필요합니다.",
          "cameraPermission": "문서를 촬영하기 위해 카메라 접근이 필요합니다."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "문서를 촬영하기 위해 카메라 접근이 필요합니다.",
          "recordAudioAndroid": false
        }
      ],
      "expo-document-picker",
      "expo-notifications",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
